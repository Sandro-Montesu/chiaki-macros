def import_macros(path, force=False):
    if not os.path.exists(path):
        print(f"ERROR: File not found: {path}")
        sys.exit(1)
    try:
        with open(path, "r") as f:
            src = json.load(f)
    except Exception as e:
        print(f"ERROR: Cannot read {path}: {e}")
        sys.exit(1)
    src_macros = src.get("macros", {})
    if not src_macros:
        print("No macros found in file.")
        return
    data = load_macros()
    current = data.get("macros", {})
    imported = 0
    skipped = 0
    print(f"Importing from: {path}")
    print(f"Source macros:  {len(src_macros)}\n")
    for name, macro in sorted(src_macros.items()):
        if name in current:
            if force:
                current[name] = macro
                imported += 1
                print(f"  {name}  ->  overwritten")
            else:
                try:
                    ans = input(f"  {name} already exists. Overwrite? [y/N] ")
                except EOFError:
                    ans = "n"
                if ans.lower() in ("y", "yes"):
                    current[name] = macro
                    imported += 1
                    print(f"    overwritten")
                else:
                    skipped += 1
                    print(f"    skipped")
        else:
            current[name] = macro
            imported += 1
            print(f"  {name}  ->  imported")
    data["macros"] = current
    save_macros(data)
    print(f"\nDone: {imported} imported, {skipped} skipped")
    print(f"Config: {MACROS_FILE}")


