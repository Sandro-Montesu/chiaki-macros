def cmd_orchestrate_init(path):
    """Interactive wizard to create an orchestration config."""
    data = load_macros()
    macros = data.get("macros", {})
    if not macros:
        print("ERROR: No macros saved. Record at least one macro first.")
        sys.exit(1)

    if os.path.exists(path):
        ans = input(f"File '{path}' exists. Overwrite? [y/N] ")
        if ans.lower() not in ("y", "yes"):
            print("Aborted.")
            sys.exit(0)

    B = "\033[1m"
    C = "\033[36m"
    G = "\033[32m"
    Y = "\033[33m"
    R = "\033[0m"

    # Build sorted macro list for menus
    macro_list = sorted(macros.items())
    macro_names = [n for n, _ in macro_list]

    def pick_macro(prompt, allow_none=False):
        print(f"\n{B}{prompt}{R}")
        for i, (n, m) in enumerate(macro_list):
            dur = m.get("duration_us", 0) // 1000
            src = m.get("device_profile", {}).get("name", "?")
            print(f"  {C}{i+1:>2}{R}. {n:<25s}  {Y}{dur//1000}.{dur%1000:01d}s{R}  ({src})")
        if allow_none:
            print(f"  {C} 0{R}. {Y}[skip]{R}")
        while True:
            try:
                ans = input(f"Select [1-{len(macro_list)}]: ").strip()
                if allow_none and ans == "0":
                    return None
                idx = int(ans) - 1
                if 0 <= idx < len(macro_list):
                    return macro_names[idx]
            except (ValueError, EOFError):
                pass
            print("Invalid choice.")

    def ask_float(prompt, default=None):
        d = f" [{default}]" if default is not None else ""
        while True:
            try:
                ans = input(f"{prompt}{d}: ").strip()
                if not ans and default is not None:
                    return default
                return float(ans)
            except (ValueError, EOFError):
                pass
            print("Enter a number (e.g. 23.5).")

    def ask_int(prompt, default=None):
        d = f" [{default}]" if default is not None else ""
        while True:
            try:
                ans = input(f"{prompt}{d}: ").strip()
                if not ans and default is not None:
                    return default
                return int(ans)
            except (ValueError, EOFError):
                pass
            print("Enter an integer.")

    def ask_str(prompt, default=""):
        d = f" [{default}]" if default else ""
        ans = input(f"{prompt}{d}: ").strip()
        return ans if ans else default

    def ask_bool(prompt, default=True):
        hint = "Y/n" if default else "y/N"
        ans = input(f"{prompt} [{hint}]: ").strip().lower()
        if not ans:
            return default
        return ans in ("y", "yes")

    # ── Header ──
    print(f"\n{B}{'─'*60}{R}")
    print(f"  {B}chiaki-macro orchestrate config generator{R}")
    print(f"{B}{'─'*60}{R}")

    # ── Step 1: Main macro ──
    main_macro = pick_macro(f"Step 1/{C}3{R}: Select the {B}main macro{R}")
    print(f"  {G}→ main.macro = \"{main_macro}\"{R}")

    # ── Step 2: OCR ──
    print()
    enable_ocr = ask_bool(f"Step 2/{C}3{R}: Enable OCR level check?", True)
    ocr_at_s = None
    region = ""
    whitelist = "0123456789"

    if enable_ocr:
        ocr_at_s = ask_float("  Timestamp in macro (seconds)", 23.5)
        print(f"  {G}→ OCR at {ocr_at_s}s{R}")
        if ask_bool("  Calibrate region interactively now? (opens screenshot)", True):
            _ocr_test_interactive()
            print()
            region = ask_str("  Paste region (x,y,w,h)")
        else:
            region = ask_str("  Region (x,y,w,h)", "800,50,200,40")
        whitelist = ask_str("  OCR whitelist characters", "0123456789")
        print(f"  {G}→ region = \"{region}\"{R}")

    # ── Step 3: Tasks ──
    print()
    print(f"Step 3/{C}3{R}: {B}Tasks{R} (triggered when level >= requirement)")
    tasks = []
    if ask_bool("Add tasks?", True):
        while True:
            print(f"\n  {B}── Task #{len(tasks)+1} ──{R}")
            tname = ask_str("  Name")
            if not tname:
                tname = f"task_{len(tasks)+1}"
            treq = ask_int("  Level required", 1)
            tmacro = pick_macro(f"  Select macro for this task")
            print(f"  {G}→ {tname} (req {treq}) → {tmacro}{R}")
            tasks.append({
                "name": tname, "level_req": treq,
                "macro": tmacro,
                "execute_time": "after_current_macro",
                "completed": False,
            })
            if not ask_bool("  Add another task?", False):
                break

    # ── Write config ──
    print(f"\n{B}{'─'*60}{R}")
    with open(path, "w") as f:
        f.write("# chiaki-macro orchestration config\n\n")
        f.write("[main]\n")
        f.write(f"macro = \"{main_macro}\"\n\n")
        if enable_ocr:
            f.write("[ocr]\n")
            f.write(f"enabled_at_s = {ocr_at_s}\n")
            f.write(f"region = \"{region}\"\n")
            f.write(f"whitelist = \"{whitelist}\"\n\n")
        for t in tasks:
            f.write("[[task]]\n")
            f.write(f"name = \"{t['name']}\"\n")
            f.write(f"level_req = {t['level_req']}\n")
            f.write(f"macro = \"{t['macro']}\"\n")
            f.write("execute_time = \"after_current_macro\"\n")
            f.write("completed = false\n\n")

    print(f"  {G}Saved:{R} {path}")
    print()
    print(f"  Run with:")
    print(f"  {B}chiaki-macro orchestrate {path} -n 100{R}")
    print()


def collage_macro(name, parts):
    """Concatenate multiple macros into one, adjusting timestamps."""
    data = load_macros()
    all_macros = data.get("macros", {})

    # Validate all parts exist
    missing = [p for p in parts if p not in all_macros]
    if missing:
        print(f"ERROR: Macro(s) not found: {', '.join(missing)}")
        sys.exit(1)

    if name in all_macros:
        ans = input(f"Macro '{name}' exists. Overwrite? [y/N] ")
        if ans.lower() not in ("y", "yes"):
            print("Aborted.")
            sys.exit(0)

    # Validate all macros use the same device type
    profiles = []
    for p in parts:
        m = all_macros[p]
        profile = m.get("device_profile", {})
        if not profile:
            print(f"ERROR: Macro '{p}' has no device profile. Re-record it.")
            sys.exit(1)
        profiles.append(profile)

    ref = profiles[0]
    vendor = ref.get("vendor", 0)
    product = ref.get("product", 0)
    for i, pr in enumerate(profiles):
        if pr.get("vendor") != vendor or pr.get("product") != product:
            print(f"WARNING: '{parts[0]}' ({ref.get('name')}) vs '{parts[i]}' ({pr.get('name')})")
            print("  Different controllers — replay may behave unexpectedly.")
            break

    # Concatenate frames with adjusted timestamps
    all_frames = []
    offset_us = 0
    total_changes = 0

    for pi, p in enumerate(parts):
        m = all_macros[p]
        src_frames = m.get("frames", [])
        if not src_frames:
            print(f"ERROR: Macro '{p}' has no frames.")
            sys.exit(1)

        for frame in src_frames:
            ts = frame.get(K_TS, frame.get("ts", 0) * 1000)
            events = frame.get(K_EVENTS, frame.get("events", []))

            if offset_us == 0 and pi == 0:
                # First frame of first macro: keep as-is
                all_frames.append({K_TS: ts, K_EVENTS: events})
            elif pi > 0 and offset_us == 0:
                # First frame of subsequent macro: skip if it's just initial state
                # (frame 0 with only ABS events — we already have state from previous macro)
                pass
            else:
                # Skip frame 0 of non-first macros (initial state snapshot)
                if pi > 0 and ts == 0:
                    continue
                all_frames.append({K_TS: ts + offset_us, K_EVENTS: events})
            total_changes += len(events)

        last_ts = src_frames[-1].get(K_TS, src_frames[-1].get("ts", 0) * 1000)
        offset_us += last_ts

    total_duration = all_frames[-1][K_TS]

    # Merge first frame of each non-first macro into the transition
    # Actually, we need the state from the first frame of macro 2 to be present
    # at the transition point. Let me insert it at offset of previous macro's end.
    # We need to redo this properly.

    # Simplified: just concatenate all frames, skipping frame 0 of non-first macros
    all_frames = []
    offset_us = 0

    for pi, p in enumerate(parts):
        m = all_macros[p]
        src_frames = m.get("frames", [])

        for fi, frame in enumerate(src_frames):
            ts = frame.get(K_TS, frame.get("ts", 0) * 1000)
            events = list(frame.get(K_EVENTS, frame.get("events", [])))

            if pi > 0 and fi == 0:
                # Skip frame 0 of subsequent macros (initial state snapshot)
                # But add its ABS events as frame at the transition point
                # to set the correct starting position for this segment
                abs_events = [e for e in events if e.get(K_TYPE, 0) == ecodes.EV_ABS]
                if abs_events:
                    all_frames.append({K_TS: offset_us, K_EVENTS: abs_events})
                continue

            new_ts = ts + offset_us
            all_frames.append({K_TS: new_ts, K_EVENTS: events})

        last_ts = src_frames[-1].get(K_TS, src_frames[-1].get("ts", 0) * 1000)
        offset_us += last_ts

    total_duration = all_frames[-1][K_TS]

    data["macros"][name] = {
        "created": datetime.now().isoformat(),
        "device_profile": ref,
        "duration_us": total_duration,
        "frames": all_frames,
        "collage_parts": parts,
    }
    save_macros(data)

    print(f"Collage '{name}' created from: {' + '.join(parts)}")
    print(f"Frames: {len(all_frames)}  Duration: {total_duration//1000}ms ({total_duration/1000000:.1f}s)")
    print(f"Saved: {MACROS_FILE}")


