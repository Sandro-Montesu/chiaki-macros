HD_PID_FILE = "/tmp/chiaki-headless.pid"
HD_DISPLAY = ":99"
HD_RESOLUTION = "1366x768x24"
HD_SOCK = "/tmp/chiaki-gamepad.sock"
HD_PROFILE = "/tmp/chiaki-bridge-profile.json"


def _find_chiaki():
    path = os.environ.get("CHIAKI_APPIMAGE")
    if path and os.path.exists(os.path.expanduser(path)):
        return os.path.expanduser(path)
    for p in ("~/chiaki-ng.AppImage", "~/chiaki.AppImage"):
        ep = os.path.expanduser(p)
        if os.path.exists(ep):
            return ep
    import shutil
    for name in ("chiaki-ng", "chiaki"):
        found = shutil.which(name)
        if found:
            return found
    return None


def _hd_is_running():
    try:
        with open(HD_PID_FILE) as f:
            for line in f:
                for pid_str in line.split():
                    try:
                        os.kill(int(pid_str), 0)
                        return True
                    except (OSError, ValueError):
                        pass
    except FileNotFoundError:
        pass
    return False


def _hd_cleanup():
    for f in (HD_PID_FILE, "/tmp/.X99-lock", HD_SOCK, HD_PROFILE):
        try:
            os.unlink(f)
        except FileNotFoundError:
            pass


def _hd_save_profile():
    data = load_macros()
    for m in data.get("macros", {}).values():
        prof = m.get("device_profile", {})
        if prof:
            prof = dict(prof)
            prof.pop("ev_ff", None)
            with open(HD_PROFILE, "w") as f:
                json.dump(prof, f)
            print(f"  Profile: {prof.get('name', '?')} "
                  f"(0x{prof['vendor']:04x}:0x{prof['product']:04x})")
            return
    print("WARNING: No device profile found in macros. Record one first.")


def cmd_headless_start(args):
    nickname = args.nickname
    host = args.host or "auto"

    if _hd_is_running():
        print("Chiaki headless already running. Stop it first.")
        sys.exit(1)

    chiaki_bin = args.chiaki_bin or _find_chiaki()
    if not chiaki_bin:
        print("ERROR: chiaki-ng not found.")
        print("  Expected: ~/chiaki-ng.AppImage or chiaki-ng in PATH")
        sys.exit(1)

    _hd_cleanup()

    _hd_save_profile()

    bridge_dir = os.path.dirname(os.path.abspath(__file__))
    bridge_path = os.path.join(bridge_dir, "chiaki-gamepad-bridge")

    # 1. Gamepad bridge
    bridge = subprocess.Popen([sys.executable, bridge_path])
    time.sleep(0.3)
    if bridge.poll() is not None:
        print("ERROR: Gamepad bridge failed to start")
        sys.exit(1)
    print(f"  Bridge PID: {bridge.pid}")

    # 2. Xvfb
    xvfb = subprocess.Popen(
        ["Xvfb", HD_DISPLAY, "-screen", "0", HD_RESOLUTION, "-ac",
         "+extension", "GLX", "+render"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    time.sleep(0.5)
    if xvfb.poll() is not None:
        bridge.kill()
        print("ERROR: Xvfb failed to start")
        sys.exit(1)
    print(f"  Xvfb PID: {xvfb.pid}")

    # 3. Chiaki
    env = os.environ.copy()
    env.update({
        "DISPLAY": HD_DISPLAY,
        "QT_QPA_PLATFORM": "xcb",
        "WAYLAND_DISPLAY": "",
        "LIBGL_ALWAYS_SOFTWARE": "1",
        "SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS": "1",
        "SDL_GAMECONTROLLER_ALLOW_BACKGROUND_EVENTS": "1",
    })
    import platform as _plat
    if _plat.machine().startswith(("arm", "aarch")):
        env["QT_XCB_GL_INTEGRATION"] = "xcb_egl"
        env["QT_OPENGL"] = "es2"
    chiaki_log = open("/tmp/chiaki-stderr.log", "w")
    chiaki = subprocess.Popen(
        [chiaki_bin, "stream", nickname, host, "--fullscreen",
         "--exit-app-on-stream-exit"],
        env=env, stdout=chiaki_log, stderr=chiaki_log,
    )
    time.sleep(1.5)
    if chiaki.poll() is not None:
        bridge.kill()
        xvfb.kill()
        print("ERROR: Chiaki failed to start")
        sys.exit(1)
    print(f"  Chiaki PID: {chiaki.pid}")

    with open(HD_PID_FILE, "w") as f:
        f.write(f"{xvfb.pid} {bridge.pid} {chiaki.pid}\n")

    print(f"\n=== Chiaki headless running ===")
    print(f"  Display:    {HD_DISPLAY}")
    print(f"  Resolution: 1366x768")
    print(f"  Nickname:   {nickname}")
    if host != "auto":
        print(f"  Host:       {host}")
    print()
    print(f"  Stop with:  chiaki-macro headless-stop")


def cmd_headless_stop(args):
    if not _hd_is_running():
        print("Chiaki headless is not running.")
        _hd_cleanup()
        return

    print("Stopping Chiaki headless...")
    try:
        with open(HD_PID_FILE) as f:
            pids = f.read().split()
    except FileNotFoundError:
        pids = []

    for pid_str in pids:
        try:
            pid = int(pid_str)
            os.kill(pid, signal.SIGTERM)
        except (OSError, ValueError):
            pass
    time.sleep(0.5)
    for pid_str in pids:
        try:
            pid = int(pid_str)
            os.kill(pid, signal.SIGKILL)
        except (OSError, ValueError):
            pass

    _hd_cleanup()
    print("Chiaki headless stopped.")


def cmd_headless_status(args):
    if not _hd_is_running():
        print("Chiaki headless is NOT running")
        return

    print("Chiaki headless is RUNNING")
    print(f"  Display:    {HD_DISPLAY}")
    try:
        with open(HD_PID_FILE) as f:
            pids = f.read().split()
        labels = ("Xvfb", "Bridge", "Chiaki")
        for i, pid_str in enumerate(pids):
            label = labels[i] if i < len(labels) else f"PID{i+1}"
            try:
                os.kill(int(pid_str), 0)
                print(f"  {label} PID: {pid_str}")
            except OSError:
                print(f"  {label} PID: {pid_str} (stopped)")
    except FileNotFoundError:
        print("  (no PID file)")


# ── main ────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(description="Record and replay gamepad macros for Chiaki")
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("list", help="List saved macros")
    sub.add_parser("devices", help="List input devices")

    p = sub.add_parser("record", help="Record macro from gamepad")
    p.add_argument("name", help="Macro name")
    p.add_argument("--device", "-d", help="Path to input device")
    p.add_argument("-y", "--yes", action="store_true", help="Overwrite without asking")

    p = sub.add_parser("play", help="Replay macro via virtual gamepad")
    p.add_argument("name", help="Macro name")
    p.add_argument("-n", "--loops", type=int, default=1,
                   help="Replays: -1=infinite, 0=skip, N=times")
    p.add_argument("--screenshot-at", type=float,
                   help="Take screenshot at this second (e.g. 23.5)")
    p.add_argument("--screenshot-dir",
                   help="Directory for screenshots (default: ~/chiaki-screenshots)")

    p = sub.add_parser("delete", help="Delete a macro")
    p.add_argument("name", help="Macro name")

    p = sub.add_parser("import", help="Import macros from another config file")
    p.add_argument("path", help="Path to macros.json file")
    p.add_argument("-y", "--yes", action="store_true",
                   help="Overwrite all existing macros without asking")

    p = sub.add_parser("orchestrate", help="Run main macro with OCR-based task system")
    p.add_argument("config", help="Path to TOML config file")
    p.add_argument("-n", "--loops", type=int, default=1,
                   help="Number of main macro loops (-1=infinite)")
    p.add_argument("--log", help="Also write all output to this log file")

    p = sub.add_parser("orchestrate-init", help="Interactive config wizard for orchestrate")
    p.add_argument("path", help="Output TOML config path")

    p = sub.add_parser("collage", help="Concatenate macros into one")
    p.add_argument("name", help="Name for the new macro")
    p.add_argument("--parts", nargs="+", required=True,
                   help="Ordered list of macro names to concatenate")

    p = sub.add_parser("ocr-test", help="Test OCR on a screenshot region")
    p.add_argument("--region", required=False,
                   help="Region to OCR, e.g. '800,50,200,40' (x,y,w,h)")
    p.add_argument("-i", "--interactive", action="store_true",
                   help="Interactive region selection (drag mouse)")

    p = sub.add_parser("headless-start", help="Start Chiaki on headless Xvfb display")
    p.add_argument("nickname", help="PS5 nickname from chiaki-ng config (e.g. PS5-226)")
    p.add_argument("host", nargs="?", help="PS5 IP address (optional, uses PSN discovery)")
    p.add_argument("--chiaki-bin", help="Path to chiaki-ng binary (default: auto-detect)")

    sub.add_parser("headless-stop", help="Stop headless Chiaki and Xvfb")
    sub.add_parser("headless-status", help="Show headless Chiaki status")

    args = parser.parse_args()

    if args.command == "ocr-test" and not args.interactive and not args.region:
        parser.error("ocr-test requires --region or --interactive")

    cmds = {
        "list": list_macros,
        "devices": cmd_devices,
        "record": lambda: record_macro(args.name, getattr(args, "device", None),
                                       getattr(args, "yes", False)),
        "play": lambda: play_macro(
            args.name, getattr(args, "loops", 1),
            getattr(args, "screenshot_at", None),
            getattr(args, "screenshot_dir", None)),
        "delete": lambda: delete_macro(args.name),
        "import": lambda: import_macros(args.path, getattr(args, "yes", False)),
        "orchestrate": lambda: orchestrate(args.config, getattr(args, "loops", 1),
                                            getattr(args, "log", None)),
        "orchestrate-init": lambda: cmd_orchestrate_init(args.path),
        "ocr-test": lambda: cmd_ocr_test(getattr(args, "region", None),
                                          getattr(args, "interactive", False)),
        "collage": lambda: collage_macro(args.name, args.parts),
        "headless-start": lambda: cmd_headless_start(args),
        "headless-stop": lambda: cmd_headless_stop(args),
        "headless-status": lambda: cmd_headless_status(args),
    }
    cmds[args.command]()


if __name__ == "__main__":
    main()
