#!/usr/bin/env python3
"""
chiaki-macro - Record and replay gamepad macros for Chiaki remote play.

Raw passthrough recorder: captures every SYN_REPORT batch exactly as the
controller sends it, including stick jitter. Replays with microsecond
busy-wait timing.  Supports orchestration with OCR-based conditional tasks.

Storage: ~/.config/chiaki-macro/macros.json
"""

import argparse
import json
import os
import re
import select
import signal
import socket
import subprocess
import sys
import time
from datetime import datetime
from evdev import InputDevice, UInput, AbsInfo, ecodes, list_devices

CONFIG_DIR = os.path.expanduser("~/.config/chiaki-macro")
MACROS_FILE = os.path.join(CONFIG_DIR, "macros.json")

K_TYPE = "t"
K_CODE = "c"
K_VALUE = "v"
K_TS = "ts"
K_EVENTS = "e"


# ── Logging helpers ─────────────────────────────────────────────────

class _Tee:
    """Duplicate writes to multiple file objects."""
    def __init__(self, *files):
        self._files = files
    def write(self, data):
        for f in self._files:
            f.write(data)
    def flush(self):
        for f in self._files:
            f.flush()

def _setup_log(path):
    """Redirect stdout to both console and a log file."""
    log = open(path, "a", buffering=1)
    sys.stdout = _Tee(sys.__stdout__, log)
    print(f"[log: {path}]")


# ── Device profile ──────────────────────────────────────────────────

def capture_device_profile(dev):
    caps = dev.capabilities()
    abs_info = []
    for code, ainfo in caps.get(ecodes.EV_ABS, []):
        abs_info.append({
            K_CODE: code, K_VALUE: ainfo.value,
            "min": ainfo.min, "max": ainfo.max,
            "flat": ainfo.flat, "fuzz": ainfo.fuzz,
            "resolution": ainfo.resolution,
        })
    return {
        "name": dev.name,
        "vendor": dev.info.vendor,
        "product": dev.info.product,
        "version": dev.info.version,
        "bustype": dev.info.bustype,
        "ev_key": list(caps.get(ecodes.EV_KEY, [])),
        "ev_abs": abs_info,
        "ev_ff": list(caps.get(ecodes.EV_FF, [])),
    }


def build_uinput_caps(profile):
    caps = {ecodes.EV_KEY: profile["ev_key"]}
    abs_list = []
    for a in profile["ev_abs"]:
        abs_list.append((
            a[K_CODE],
            AbsInfo(a[K_VALUE], a["min"], a["max"],
                    a["flat"], a["fuzz"], a["resolution"]),
        ))
    caps[ecodes.EV_ABS] = abs_list
    return caps


def load_macro_data(name):
    data = load_macros()
    if name not in data["macros"]:
        print(f"ERROR: Macro '{name}' not found.")
        sys.exit(1)
    m = data["macros"][name]
    profile = m.get("device_profile", {})
    if not profile:
        print("ERROR: Macro has no device profile. Please re-record.")
        sys.exit(1)
    frames = m["frames"]
    last = frames[-1]
    duration_us = m.get("duration_us", last.get(K_TS, last.get("ts", 0) * 1000))
    return profile, frames, duration_us


# ── UInput helpers ──────────────────────────────────────────────────

BRIDGE_SOCK = "/tmp/chiaki-gamepad.sock"


class _BridgeVpad:
    """Mimics UInput interface but sends events through Unix socket to
    chiaki-gamepad-bridge (which owns the real /dev/uinput device)."""
    def __init__(self):
        self._sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self._sock.connect(BRIDGE_SOCK)
        self._sock.setblocking(True)
        self._buf = b""
        self.device = type("_D", (), {"path": f"bridge:{BRIDGE_SOCK}"})()

    def write(self, etype, ecode, evalue):
        self._buf += f"{etype} {ecode} {evalue}\n".encode()

    def syn(self):
        self._buf += b"\n"
        self._sock.sendall(self._buf)
        self._buf = b""

    def close(self):
        try:
            self._sock.close()
        except Exception:
            pass


def _create_vpad(profile):
    # Try bridge first (persistent UInput, Chiaki detects it at startup)
    if os.path.exists(BRIDGE_SOCK):
        try:
            vp = _BridgeVpad()
            print(f"Using gamepad bridge ({BRIDGE_SOCK})")
            return vp
        except Exception as e:
            print(f"Bridge connect failed ({e}), falling back to direct UInput...")

    vname = f"Chiaki Replay [{profile.get('name', 'gamepad')}]"
    try:
        return UInput(
            events=build_uinput_caps(profile), name=vname,
            vendor=profile["vendor"], product=profile["product"],
            version=profile["version"], bustype=profile["bustype"],
        )
    except (PermissionError, OSError):
        print("ERROR: Cannot write to /dev/uinput. Run with sudo.")
        sys.exit(1)


def _wait_detect(vpad):
    if isinstance(vpad, _BridgeVpad):
        return  # bridge gamepad already exists, Chiaki detected it at startup
    print("Waiting 2 seconds for Chiaki to detect...")
    wstart = time.perf_counter()
    while time.perf_counter() - wstart < 2:
        vpad.syn()
        time.sleep(0.1)


# ── Single-loop replay (shared) ─────────────────────────────────────

def _replay_one_loop(vpad, frames, duration_us, *,
                      screenshot_at_us=None, on_screenshot=None):
    """Replay one loop of a macro. Calls on_screenshot(path) at the right time.
    Returns the screenshot path if taken, else None."""
    duration_ms = duration_us // 1000
    replay_start = time.perf_counter()
    last_ts = 0
    ss_taken = False
    ss_path = None

    for i, frame in enumerate(frames):
        ts = frame.get(K_TS, frame.get("ts", 0) * 1000)
        if ts > last_ts:
            target = replay_start + (ts / 1_000_000.0)
            while time.perf_counter() < target:
                time.sleep(0.0001)

        for ek in (K_EVENTS, "events"):
            if ek in frame:
                for ev in frame[ek]:
                    vpad.write(ev[K_TYPE], ev[K_CODE], ev[K_VALUE])
                break
        vpad.syn()
        last_ts = ts

        if screenshot_at_us and not ss_taken and ts >= screenshot_at_us:
            ss_taken = True
            if on_screenshot:
                ss_path = on_screenshot()

        if i % 500 == 0 or i == len(frames) - 1:
            elapsed = time.perf_counter() - replay_start
            print(f"\r  frame {i+1}/{len(frames)}  {ts//1000}/{duration_ms}ms  ({elapsed:.1f}s)", end="", flush=True)

    elapsed = time.perf_counter() - replay_start
    print(f"\r  frame {len(frames)}/{len(frames)}  {duration_ms}/{duration_ms}ms  ({elapsed:.1f}s)")
    return ss_path


# ── Screenshot / OCR ────────────────────────────────────────────────

def _screenshot_sync(filepath):
    """Take a screenshot synchronously (blocks until done)."""
    _screenshot_async_bg(filepath)
    # Wait for file to appear
    deadline = time.perf_counter() + 8
    while not os.path.exists(filepath) and time.perf_counter() < deadline:
        time.sleep(0.1)
    return os.path.exists(filepath)


def _screenshot_async_bg(filepath):
    """Launch screenshot in a background subprocess — returns immediately."""
    headless_display = os.environ.get("CHIAKI_HEADLESS_DISPLAY")
    if not headless_display:
        # Auto-detect: if Xvfb :99 is running, use it
        try:
            result = subprocess.run(
                ["pgrep", "-f", "Xvfb :99"],
                capture_output=True, timeout=2,
            )
            if result.returncode == 0 and result.stdout.strip():
                headless_display = ":99"
        except Exception:
            pass
    if headless_display:
        try:
            env = os.environ.copy()
            env["DISPLAY"] = headless_display
            subprocess.Popen(
                ["import", "-window", "root", filepath],
                env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
            return
        except FileNotFoundError:
            print("[screenshot] ERROR: 'import' not found. Install: sudo apt install imagemagick")
            return
        except Exception as e:
            print(f"[screenshot] ERROR: {e}")
            return

    code = f'''
import dbus, dbus.mainloop.glib, os, shutil
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import GLib
DBusGMainLoop(set_as_default=True)
bus = dbus.SessionBus()
portal = bus.get_object("org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop")
iface = dbus.Interface(portal, "org.freedesktop.portal.Screenshot")
r = [None]
def cb(c, res):
    r[0] = res.get("uri", "") if res else ""
reply = str(iface.Screenshot("", {{"handle_token": "chiaki_ss", "interactive": False}}))
bus.add_signal_receiver(cb, signal_name="Response",
    dbus_interface="org.freedesktop.portal.Request",
    bus_name="org.freedesktop.portal.Desktop", path=reply)
loop = GLib.MainLoop()
GLib.timeout_add(5000, loop.quit)
loop.run()
uri = r[0]
if uri and uri.startswith("file://"):
    src = uri[7:]
    if os.path.exists(src):
        shutil.move(src, "{filepath}")
'''
    try:
        subprocess.Popen(
            [sys.executable, "-c", code],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass


def _ocr_read_number(image_path, whitelist="0123456789Oo"):
    """OCR with preprocessing optimized for speed (Pi Zero) and accuracy.
    Uses Otsu binarization + 2x upscale + majority voting across 3 PSM modes.
    Falls back to global thresholds if Otsu fails (handles thin digits like 0).
    Maps O/o to 0 since many game fonts lack a slashed zero."""
    try:
        from PIL import Image, ImageOps

        img = Image.open(image_path).convert("L")

        # 2x upscale (fast enough for Pi Zero)
        img = img.resize((img.width * 2, img.height * 2), Image.LANCZOS)

        def try_ocr(preproc_img):
            preproc_img.save("/tmp/_chiaki_ocr_tmp.png")
            results = []
            for psm in (7, 8, 6):
                r = subprocess.run(
                    ["tesseract", "/tmp/_chiaki_ocr_tmp.png", "stdout",
                     "--psm", str(psm), "--oem", "1",
                     "-c", f"tessedit_char_whitelist={whitelist}"],
                    capture_output=True, text=True, timeout=6,
                )
                text = r.stdout.strip()
                # Replace O/o with 0 (many game fonts lack slashed zero)
                text = text.replace("O", "0").replace("o", "0")
                match = re.search(r'\d+', text)
                if match:
                    results.append(int(match.group()))
            return results

        # Attempt 1: Otsu auto-threshold
        hist = img.histogram()
        otsu_thresh = _otsu_threshold(hist)
        img1 = img.point(lambda p: 0 if p < otsu_thresh else 255)
        img1 = ImageOps.invert(img1)
        img1 = ImageOps.expand(img1, border=2, fill=255)
        results = try_ocr(img1)

        # If modes disagree, try global threshold 140
        if len(set(results)) > 1:
            img2 = img.point(lambda p: 0 if p < 140 else 255)
            img2 = ImageOps.invert(img2)
            img2 = ImageOps.expand(img2, border=2, fill=255)
            results2 = try_ocr(img2)
            results.extend(results2)
        # If no results at all, try multiple thresholds (thin digits like 0)
        elif not results:
            for thresh in (128, 100, 80):
                img2 = img.point(lambda p: 0 if p < thresh else 255)
                img2 = ImageOps.invert(img2)
                img2 = ImageOps.expand(img2, border=2, fill=255)
                results2 = try_ocr(img2)
                results.extend(results2)
                if results:
                    break

        if results:
            return max(set(results), key=results.count)
        return None
    except Exception:
        return None


def _otsu_threshold(hist):
    """Compute Otsu's optimal threshold from image histogram."""
    total = sum(hist)
    if total == 0:
        return 128
    sum_b = 0
    w_b = 0
    maximum = 0
    threshold = 0
    sum_total = sum(i * h for i, h in enumerate(hist))
    for i, h in enumerate(hist):
        w_b += h
        if w_b == 0:
            continue
        w_f = total - w_b
        if w_f == 0:
            break
        sum_b += i * h
        m_b = sum_b / w_b
        m_f = (sum_total - sum_b) / w_f
        between = w_b * w_f * (m_b - m_f) ** 2
        if between > maximum:
            maximum = between
            threshold = i
    return max(threshold, 1)


def _crop_image(src, dst, region):
    """Crop an image using Pillow. region = (x, y, w, h)."""
    try:
        from PIL import Image
        img = Image.open(src)
        x, y, w, h = region
        cropped = img.crop((x, y, x + w, y + h))
        cropped.save(dst)
        return True
    except Exception:
        return False


def parse_region(s):
    """Parse "x,y,w,h" into (int, int, int, int)."""
    parts = s.replace(",", " ").split()
    if len(parts) != 4:
        raise ValueError(f"Region must be 'x,y,w,h', got: {s}")
    return tuple(int(p) for p in parts)


# ── play_macro (refactored) ─────────────────────────────────────────

def play_macro(name, loops=1, screenshot_at=None, screenshot_dir=None):
    try:
        profile, frames, duration_us = load_macro_data(name)
    except SystemExit:
        return

    duration_ms = duration_us // 1000
    print(f"Macro:     {name}")
    print(f"Frames:    {len(frames)}")
    print(f"Duration:  {duration_ms}ms ({duration_ms/1000:.1f}s)")
    print(f"Device:    {profile.get('name', '?')}\n")

    if loops == 0:
        print("Loops=0, exiting.")
        return

    ss_at_us = int(screenshot_at * 1_000_000) if screenshot_at else None
    ss_dir = screenshot_dir or os.path.expanduser("~/chiaki-screenshots")
    if ss_at_us:
        os.makedirs(ss_dir, exist_ok=True)

    vpad = _create_vpad(profile)
    iteration = 0
    infinite = loops < 0
    total = loops if not infinite else None
    interrupted = False

    try:
        print(f"Virtual gamepad: {vpad.device.path}")
        print(f"  Vendor: 0x{profile['vendor']:04x}  Product: 0x{profile['product']:04x}")
        print(f"  Loops: {'infinite' if infinite else total}\n")
        vpad.syn()
        _wait_detect(vpad)

        while infinite or iteration < total:
            iteration += 1
            if total and total > 1:
                print(f"--- Loop {iteration}/{total} ---")

            def take_ss():
                path = os.path.join(ss_dir, f"{name}_loop{iteration}_{screenshot_at:.1f}s.png")
                _screenshot_sync(path)
                return path

            result = _replay_one_loop(vpad, frames, duration_us,
                                       screenshot_at_us=ss_at_us,
                                       on_screenshot=take_ss if ss_at_us else None)
            if result:
                print(f"  [screenshot: {result}]")

    except KeyboardInterrupt:
        interrupted = True
        print("\nReplay interrupted.")
    finally:
        try:
            vpad.close()
        except Exception:
            pass
        if interrupted:
            print("Virtual gamepad removed.")


# ── orchestrate ─────────────────────────────────────────────────────

def _parse_toml(path):
    """Parse a TOML config file. Returns dict or exits."""
    try:
        import tomllib
    except ImportError:
        print("ERROR: Python 3.11+ required for TOML support.")
        sys.exit(1)
    try:
        with open(path, "rb") as f:
            return tomllib.load(f)
    except Exception as e:
        print(f"ERROR reading {path}: {e}")
        sys.exit(1)


def _save_toml(path, config):
    """Write a TOML config back. Preserves comments via manual write."""
    try:
        with open(path, "r") as f:
            lines = f.readlines()
    except Exception:
        lines = []

    out = []
    in_task = False
    task_idx = 0
    task_i = 0
    for line in lines:
        s = line.rstrip()
        if s.startswith("[[task]]"):
            in_task = True
            task_i = task_idx
            task_idx += 1
            out.append(line.rstrip("\n"))
        elif s.startswith("completed ="):
            if in_task and task_i < len(config.get("task", [])):
                val = str(config["task"][task_i].get("completed", False)).lower()
                out.append(f"completed = {val}\n")
                in_task = False
            else:
                out.append(line.rstrip("\n"))
        else:
            out.append(line.rstrip("\n"))

    with open(path, "w") as f:
        f.write("\n".join(out) + "\n")


def orchestrate(config_path, loops, log_path=None):
    if log_path:
        _setup_log(log_path)

    config = _parse_toml(config_path)
    main_cfg = config.get("main", {})
    main_name = main_cfg.get("macro")
    if not main_name:
        print("ERROR: [main] must have 'macro' key.")
        sys.exit(1)

    ocr_cfg = config.get("ocr", {})
    ss_at_s = ocr_cfg.get("enabled_at_s")
    region_str = ocr_cfg.get("region", "")
    whitelist = ocr_cfg.get("whitelist", "0123456789")
    ocr_dir = os.path.expanduser("~/chiaki-orchestrate")
    os.makedirs(ocr_dir, exist_ok=True)

    tasks = config.get("task", [])
    # Build pending list, tracking original index
    pending_tasks = []
    for idx, t in enumerate(tasks):
        if not t.get("completed", False):
            pending_tasks.append((idx, t))

    # Load main macro once
    try:
        profile, frames, duration_us = load_macro_data(main_name)
    except SystemExit:
        return

    duration_ms = duration_us // 1000
    ss_at_us = int(ss_at_s * 1_000_000) if ss_at_s else None
    region = parse_region(region_str) if region_str else None

    # Pre-load task macros
    task_macros = {}
    for idx, t in pending_tasks:
        try:
            tp, tf, td = load_macro_data(t["macro"])
            task_macros[t["name"]] = (tp, tf, td)
        except SystemExit:
            print(f"WARNING: Task '{t['name']}' macro '{t['macro']}' not found, skipping.")
            tasks[idx]["completed"] = True

    pending_tasks = [(idx, t) for idx, t in pending_tasks if t["name"] in task_macros]

    print(f"Orchestrator: {config_path}")
    print(f"  Main macro: {main_name}  ({duration_ms//1000:.1f}s)")
    if ss_at_us:
        print(f"  OCR at {ss_at_s}s  region={region_str}")
    if pending_tasks:
        print(f"  Pending tasks: {len(pending_tasks)}")
        for idx, t in pending_tasks:
            print(f"    {t['name']}  (level_req={t.get('level_req', '?')}, macro={t['macro']})")
    headless_disp = os.environ.get("CHIAKI_HEADLESS_DISPLAY")
    if ss_at_us:
        method = f"Xvfb {headless_disp}" if headless_disp else "D-Bus portal (global)"
        print(f"  Screenshot: {method}")
    print()

    if loops == 0:
        print("Loops=0, exiting.")
        return

    vpad = _create_vpad(profile)
    iteration = 0
    infinite = loops < 0
    total = loops if not infinite else None
    interrupted = False

    try:
        print(f"Virtual gamepad: {vpad.device.path}")
        print(f"  Vendor: 0x{profile['vendor']:04x}  Product: 0x{profile['product']:04x}")
        print(f"  Loops: {'infinite' if infinite else total}\n")
        vpad.syn()
        _wait_detect(vpad)

        while infinite or iteration < total:
            iteration += 1
            print(f"--- Loop {iteration}" + (f"/{total}" if total else "") + " ---")

            # Play main macro — screenshot launched async, never blocks replay
            ss_file = os.path.join(ocr_dir, f"_ocr_loop{iteration}.png") if ss_at_us else None

            def on_ss():
                if ss_file:
                    _screenshot_async_bg(ss_file)
                return ss_file

            _replay_one_loop(vpad, frames, duration_us,
                             screenshot_at_us=ss_at_us,
                             on_screenshot=on_ss if ss_at_us else None)

            # OCR check: wait for async screenshot, then process
            if ss_file and region:
                deadline = time.perf_counter() + 8
                while not os.path.exists(ss_file) and time.perf_counter() < deadline:
                    time.sleep(0.1)
                if os.path.exists(ss_file):
                    crop_file = ss_file.replace(".png", "_crop.png")
                    if _crop_image(ss_file, crop_file, region):
                        level = _ocr_read_number(crop_file, whitelist)
                        print(f"  [OCR] level: {level if level is not None else 'N/A'}")
                        if level is not None and pending_tasks:
                            for ti, (orig_idx, t) in enumerate(pending_tasks):
                                req = t.get("level_req", 999)
                                if level >= req and t["name"] in task_macros:
                                    et = t.get("execute_time", "after_current_macro")
                                    if et == "after_current_macro":
                                        tp, tf, td = task_macros[t["name"]]
                                        print(f"  [TASK] {t['name']} (req {req}) → playing {t['macro']}...")
                                        _replay_one_loop(vpad, tf, td)
                                        t["completed"] = True
                                        tasks[orig_idx]["completed"] = True
                                        _save_toml(config_path, config)
                                        print(f"  [TASK] completed, config saved.")
                                    break  # one task per loop
                else:
                    print(f"  [OCR] screenshot not ready, skipping")
                    os.remove(ss_file) if os.path.exists(ss_file) else None

            # Remove completed tasks from pending list
            pending_tasks = [(idx, t) for idx, t in pending_tasks if not t.get("completed", False)]

            if not pending_tasks and infinite:
                print("  All tasks completed. Continuing main loop...")

        print("\nOrchestration complete.")
    except KeyboardInterrupt:
        interrupted = True
        print("\nOrchestration interrupted.")
    finally:
        try:
            vpad.close()
        except Exception:
            pass
        if interrupted:
            print("Virtual gamepad removed.")


# ── ocr-test ────────────────────────────────────────────────────────

def cmd_ocr_test(region_str, interactive=False):
    if interactive:
        _ocr_test_interactive()
        return
    if not region_str:
        print("ERROR: --region is required when not using --interactive")
        sys.exit(1)
    region = parse_region(region_str)
    ss_path = "/tmp/chiaki-ocr-test.png"
    crop_path = "/tmp/chiaki-ocr-test-crop.png"

    print(f"Taking screenshot...")
    if not _screenshot_sync(ss_path):
        print("ERROR: Screenshot failed.")
        sys.exit(1)
    print(f"Full screenshot: {ss_path}")

    if not _crop_image(ss_path, crop_path, region):
        print("ERROR: Crop failed (install Pillow: pip install Pillow).")
        sys.exit(1)
    print(f"Cropped region:  {crop_path}")

    number = _ocr_read_number(crop_path)
    print(f"OCR result:      {number if number is not None else 'N/A (no digits found)'}")
    if number is not None:
        print(f"Parsed integer:  {number}")


def _ocr_test_interactive():
    """Take a screenshot and try to open it for coordinate inspection."""
    ss_path = "/tmp/chiaki-ocr-interactive.png"
    print("Taking screenshot...")
    if not _screenshot_sync(ss_path):
        print("ERROR: Screenshot failed.")
        sys.exit(1)

    print(f"Screenshot saved: {ss_path}")
    print()

    # Try to open with available image viewer (prefer ones showing coords)
    viewers = ["gimp", "eog", "ristretto", "gwenview", "feh", "display"]
    opened = False
    for viewer in viewers:
        if subprocess.run(["which", viewer], capture_output=True).returncode == 0:
            subprocess.Popen([viewer, ss_path],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print(f"Opened in {viewer}.")
            opened = True
            break
    if not opened:
        print("Open the image manually.")
    print()
    print("Find the pixel rectangle of the level number (x, y, width, height).")
    print("In GIMP: the bottom-left shows coords. Select a rectangle for x,y,w,h.")
    print("Then run:")
    print('  chiaki-macro ocr-test --region "x,y,w,h"')


# ── record_macro ────────────────────────────────────────────────────

def find_controller(device_path=None):
    if device_path:
        try:
            dev = InputDevice(device_path)
            if ecodes.EV_KEY in dev.capabilities() and ecodes.EV_ABS in dev.capabilities():
                return dev
            print(f"WARNING: {device_path} is not a gamepad")
            return None
        except Exception as e:
            print(f"ERROR: Cannot open {device_path}: {e}")
            return None
    controllers = []
    for path in sorted(list_devices()):
        try:
            dev = InputDevice(path)
            if ecodes.EV_KEY in dev.capabilities() and ecodes.EV_ABS in dev.capabilities():
                controllers.append(dev)
        except Exception:
            pass
    if not controllers:
        return None
    if len(controllers) > 1:
        print("Multiple controllers found. Use --device to pick one:")
        for c in controllers:
            print(f"  {c.path:30s}  {c.name}")
    return controllers[0]


def load_macros():
    os.makedirs(CONFIG_DIR, exist_ok=True)
    if not os.path.exists(MACROS_FILE):
        return {"version": 5, "macros": {}}
    with open(MACROS_FILE, "r") as f:
        return json.load(f)


def save_macros(data):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(MACROS_FILE, "w") as f:
        json.dump(data, f, indent=2, default=str)


def record_macro(name, device_path=None, force_overwrite=False):
    dev = find_controller(device_path)
    if not dev:
        print("ERROR: No controller found.")
        sys.exit(1)

    if not force_overwrite:
        data = load_macros()
        if name in data["macros"]:
            if input(f"Macro '{name}' exists. Overwrite? [y/N] ").lower() not in ("y", "yes"):
                print("Aborted.")
                sys.exit(0)

    profile = capture_device_profile(dev)
    print(f"Recording from: {dev.name} ({dev.path})")
    print(f"Macro: {name}")
    print("Recording...  Press CTRL+C to stop.\n")

    frames = []
    pending_key = []
    pending_abs = {}
    last_keys = {}
    recording_start = None
    running = [True]
    syncing = True
    total_changes = 0

    def stop(sig, frame):
        running[0] = False
    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)

    try:
        while running[0]:
            r, _, _ = select.select([dev.fd], [], [], 0.005)
            if not r:
                continue
            try:
                batch = list(dev.read())
            except Exception:
                continue
            for ev in batch:
                if not running[0]:
                    break
                if syncing:
                    if ev.type == ecodes.EV_SYN and ev.code == ecodes.SYN_REPORT:
                        syncing = False
                        recording_start = time.perf_counter()
                        frame0 = []
                        for a in profile["ev_abs"]:
                            code = a[K_CODE]
                            val = dev.absinfo(code).value
                            frame0.append({K_TYPE: ecodes.EV_ABS, K_CODE: code, K_VALUE: val})
                        for kc in dev.active_keys(verbose=True):
                            kc = kc[0] if isinstance(kc, tuple) else kc
                            if kc in profile["ev_key"]:
                                last_keys[kc] = 1
                                frame0.append({K_TYPE: ecodes.EV_KEY, K_CODE: kc, K_VALUE: 1})
                        frames.append({K_TS: 0, K_EVENTS: frame0})
                        total_changes += len(frame0)
                    continue
                if ev.type not in (ecodes.EV_KEY, ecodes.EV_ABS, ecodes.EV_SYN):
                    continue
                if ev.type == ecodes.EV_SYN:
                    if ev.code == ecodes.SYN_DROPPED:
                        print("  *** WARNING: events dropped ***")
                        pending_key.clear()
                        pending_abs.clear()
                        last_keys.clear()
                    elif ev.code == ecodes.SYN_REPORT:
                        batch_events = []
                        for e in pending_key:
                            batch_events.append(e)
                            last_keys[e[K_CODE]] = e[K_VALUE]
                        for code, val in pending_abs.items():
                            batch_events.append({K_TYPE: ecodes.EV_ABS, K_CODE: code, K_VALUE: val})
                        ts_us = int((time.perf_counter() - recording_start) * 1_000_000) if recording_start else 0
                        frames.append({K_TS: ts_us, K_EVENTS: batch_events})
                        total_changes += len(batch_events)
                        pending_key.clear()
                        pending_abs.clear()
                    continue
                if ev.type == ecodes.EV_KEY:
                    if last_keys.get(ev.code) == ev.value:
                        continue
                    pending_key.append({K_TYPE: ecodes.EV_KEY, K_CODE: ev.code, K_VALUE: ev.value})
                    label = ecodes.BTN.get(ev.code, ())
                    if isinstance(label, tuple):
                        label = label[-1] if label else f"c:{ev.code}"
                    elif not label:
                        label = ecodes.keys.get(ev.code, f"c:{ev.code}")
                    st = {0: "REL", 1: "PRS", 2: "RPT"}.get(ev.value, "?")
                    ms = int((time.perf_counter() - recording_start) * 1000) if recording_start else 0
                    print(f"  {label:>20s}  {st}  ({ms}ms)")
                elif ev.type == ecodes.EV_ABS:
                    pending_abs[ev.code] = ev.value
    except Exception as e:
        print(f"\nError: {e}")
        sys.exit(1)

    if not frames:
        print("\nNo frames recorded. Aborting.")
        sys.exit(1)

    duration_ms = frames[-1][K_TS] // 1000
    print(f"\nFrames: {len(frames)}  |  Changes: {total_changes}  |  Duration: {duration_ms}ms")

    data = load_macros()
    data["macros"][name] = {
        "created": datetime.now().isoformat(),
        "device_profile": profile,
        "duration_us": frames[-1][K_TS],
        "frames": frames,
    }
    save_macros(data)
    print(f"Saved: {name}  ->  {MACROS_FILE}")


